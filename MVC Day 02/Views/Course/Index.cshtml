@model IEnumerable<MVC_Day_02.Models.Course>

@{
    ViewData["Title"] = "Courses List";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Courses List</h2>

        <a asp-controller="Course" asp-action="Add" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Course
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Degree</th>
                <th>Min Degree</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Degree</td>
                    <td>@item.MinDegree</td>
                    <td>@item.Department?.Name</td>
                    <td>
                        <a asp-controller="Course" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>