@model List<MVC_Day_02.Models.Instructor>

@{
    ViewData["Title"] = "Instructors List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Instructors List</h2>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Salary</th>
                <th>Address</th>
                <th>Department</th>
                <th>Course</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center" style="width: 80px;">
                        <img src="~/Images/@item.ImgURL" alt="@item.Name" width="50" height="50" class="rounded-circle" style="object-fit: cover;" />
                    </td>
                    <td>@item.Name</td>
                    <td>@item.Salary.ToString("C")</td>
                    <td>@item.Address</td>
                    <td>@item.Department?.Name</td>
                    <td>@item.Course?.Name</td>
                    <td>
                        <a asp-controller="Instructor" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>